# Optional public build-time ICE configuration. Blank preserves PeerJS defaults.
# This REPLACES the default server list; include STUN if you want direct attempts.
VITE_ICE_SERVERS=
VITE_ICE_TRANSPORT_POLICY=all

# Use your own reachable TURN service. These example domains are placeholders.
# Every VITE_ value is visible to players; use limited/temporary TURN credentials.
# VITE_ICE_SERVERS='[{"urls":"stun:stun.example.com:3478"},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:443?transport=tcp"],"username":"limited-user","credential":"temporary-password"}]'
# Set relay only when a working TURN server is configured, to test its route.
# VITE_ICE_TRANSPORT_POLICY=relay
