{
  "name": "krill-duels",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "build:site": "tsc --noEmit && vite build --mode https --outDir dist/client && vite build --config vite.server.config.ts && node scripts/build-metadata.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "drizzle-orm": "0.45.2",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.2"
  }
}
